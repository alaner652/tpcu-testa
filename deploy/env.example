# Copy to .env in the project root and edit. .env is not committed.

# Database password (generate a long random string)
TESTA_DB_PASSWORD=

# Optional first-run setup token. Leave blank to have a random one written to the server log
# (docker compose -f docker-compose.prod.yml logs server). It stops working once the first administrator exists.
TESTA_SETUP_TOKEN=

# Time zone for logs and backup file names
TESTA_TZ=Asia/Taipei

# Public port. Use 127.0.0.1:8088 to accept only local connections (e.g. behind a reverse proxy on this VM)
TESTA_HTTP_PORT=80

# Only with deploy/https.yml: HTTPS port and the directory holding fullchain.pem and privkey.pem
TESTA_HTTPS_PORT=443
TESTA_TLS_DIR=./tls

# Keep true behind HTTPS. Set false only for plain HTTP on a LAN (e.g. a lab server without a certificate),
# otherwise the browser does not send the session cookie and users are signed out right after signing in.
TESTA_COOKIE_SECURE=true

# Backup directory and how many days to keep
TESTA_BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30

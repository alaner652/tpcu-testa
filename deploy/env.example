# 複製成專案根目錄的 .env 再修改。.env 不會進版本控制。

# 資料庫密碼（自己產生一組長的隨機字串）
TESTA_DB_PASSWORD=

# 第一位系統管理員。只在資料庫裡還沒有任何系統管理員時使用，登入後會被要求換密碼。
TESTA_ADMIN_EMAIL=
TESTA_ADMIN_PASSWORD=

# 對外的埠
TESTA_HTTP_PORT=80

# 走 HTTPS 時保持 true。只有在區網用純 HTTP（例如教室主機沒有憑證）才改成 false，
# 否則瀏覽器不會送出登入 cookie，會變成「登入成功後又被登出」。
TESTA_COOKIE_SECURE=true

# 備份放哪裡、保留幾天
TESTA_BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
